{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "description": "AgentQ API Testing - Contact list response body schema",
  "type": "object",
  "properties": {
    "success": {
      "type": "boolean"
    },
    "data": {
      "type": "object",
      "properties": {
        "contacts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "pagination": {
          "type": "object",
          "properties": {
            "current_page": {
              "type": "number"
            },
            "per_page": {
              "type": "number"
            },
            "total_pages": {
              "type": "number"
            },
            "total_count": {
              "type": "number"
            }
          }
        }
      },
      "required": [
        "contacts"
      ]
    }
  },
  "required": [
    "success",
    "data"
  ]
}
